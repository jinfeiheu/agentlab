# 必填:DeepSeek API Key(复制本文件为 .env 后填写)
DEEPSEEK_API_KEY=sk-your-key-here
# 可选:默认 deepseek-flash
DEEPSEEK_MODEL=deepseek-flash
# 本地 Ollama 嵌入
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=bge-m3
# 嵌入维度(bge-m3 为 1024);Store 语义索引使用同一维度
EMBED_DIMS=1024
RAG_TOP_K=3

# 检索模式:baseline(内存向量) 或 hybrid(向量 + BM25)
RAG_MODE=baseline
# 专用 cross-encoder reranker(默认开启,本地 bge-reranker-v2-m3)
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# cpu 或 cuda(cuda 需要安装 CUDA 版 torch)
RERANK_DEVICE=cpu
# 可选的第二层 LLM rerank(会增加一次模型调用,默认关闭)
LLM_RERANK_ENABLED=false

# Postgres(pgvector / checkpoint / Store)
# 本地先运行 bash scripts/start_db.sh(启动 pgvector 并写入演示工单)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentlab
# 是否使用 Postgres 持久化;默认内存,方便离线测试
USE_DB=false
PG_COLLECTION=docs
# hard 评测语料使用独立 collection,不改动 easy 的 docs
PG_HARD_COLLECTION=docs_hard

# demo 登录签名密钥;生产环境必须替换
AUTH_SECRET=dev-only-change-me-please-replace-me
# 单次对话超时(秒)与每用户每分钟请求上限
REQUEST_TIMEOUT=60
RATE_LIMIT_PER_MINUTE=30

# 可观测性:本地 Phoenix(CLI/API 共用;设为 true 才导出)
TRACING_ENABLED=false
PHOENIX_ENDPOINT=http://localhost:6006/v1/traces

# 长对话上下文与长期记忆
CONTEXT_MAX_TOKENS=6000
# 自动记忆:规则触发的结构化抽取 + 压缩时写 episode(默认关闭)
ENABLE_AUTO_MEMORY=false
# episode 记忆保留天数;仅 Postgres Store 支持 TTL,InMemoryStore 会忽略
MEMORY_EPISODE_TTL_DAYS=30

# 评测裁判模型:默认 DeepSeek;可设为 qwen3:8b 走本地 Ollama 做跨模型对照
EVAL_JUDGE_MODEL=deepseek-flash
# hard 评测语料/golden 路径(通常不需要改)
# HARD_DOCS_DIR=data/docs_hard
# HARD_GOLDEN_PATH=eval/golden_hard.jsonl

# 是否启用 MCP 工具
USE_MCP=false
# MCP 传输:stdio(本地子进程) 或 streamable_http(远程服务)
MCP_TRANSPORT=stdio
MCP_AGENTLAB_URL=http://localhost:8811/mcp
MCP_UTILS_URL=http://localhost:8812/mcp

# 可选:LangSmith 追踪(没有 key 就保持注释)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=langchain-demo
